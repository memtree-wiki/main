#!/usr/bin/env bash
# Bumps @memtree-wiki/docs' patch version whenever `dev` is merged into `main`.
set -euo pipefail

branch="$(git rev-parse --abbrev-ref HEAD)"
[ "$branch" = "main" ] || exit 0

last_merge="$(git reflog -1 --format=%gs)"
[[ "$last_merge" == "merge dev:"* ]] || exit 0

repo_root="$(git rev-parse --show-toplevel)"
docs_pkg="$repo_root/projects/docs/package.json"

new_version="$(DOCS_PKG="$docs_pkg" bun -e '
  const path = process.env.DOCS_PKG;
  const pkg = await Bun.file(path).json();
  const [major, minor, patch] = pkg.version.split(".").map(Number);
  pkg.version = `${major}.${minor}.${patch + 1}`;
  await Bun.write(path, JSON.stringify(pkg, null, 2) + "\n");
  process.stdout.write(pkg.version);
')"

git -C "$repo_root" add "$docs_pkg"
git -C "$repo_root" commit -m "chore(docs): bump @memtree-wiki/docs to $new_version" --quiet
